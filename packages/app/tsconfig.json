{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@chisacode/protocol": ["../protocol/src/index.ts"],
      "@chisacode/protocol/*": ["../protocol/src/*"],
      "@chisacode/client": ["../client/src/index.ts"],
      "@chisacode/client/*": ["../client/src/*"],
      "@chisacode/highlight": ["../highlight/src/index.ts"],
      "@chisacode/highlight/*": ["../highlight/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "react-native-web.d.ts"
  ]
}
