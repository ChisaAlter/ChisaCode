# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.secrets/

# typescript
*.tsbuildinfo

# vitest browser failure screenshots
.vitest-screenshots/

app-example

# generated native folders
/ios
/android

# TypeScript compiled JS/JSX emitted next to .ts/.tsx sources (no outDir in
# tsconfig.json — tsc writes .js alongside .ts). These are build artifacts
# tracked by their .ts/.tsx source; ignore the compiled duplicates so they
# don't pollute git status or the Metro web bundle (see metro.config.cjs
# blockList for the matching bundler-side exclusion).
/src/**/*.js
/src/**/*.jsx
/e2e/**/*.js
/test-stubs/**/*.js
/modules/**/*.js
/vitest.config.js
/vitest.setup.js
/playwright.config.js
/index.js
