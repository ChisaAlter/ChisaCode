#!/bin/sh
set -eu

SCRIPT_PATH=$0
case "$SCRIPT_PATH" in
  /*) ;;
  *) SCRIPT_PATH="$(pwd)/$SCRIPT_PATH" ;;
esac

# Follow symlinks so `/usr/local/bin/fleurdelys` resolves back into the app bundle.
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
  LINK_TARGET=$(readlink "$SCRIPT_PATH")
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH="$LINK_TARGET" ;;
    *) SCRIPT_PATH="${SCRIPT_DIR}/${LINK_TARGET}" ;;
  esac
done

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
RESOURCES_DIR=$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)

# macOS: MacOS/Fleurdelys is a sibling of Resources/
# Linux: the executable sits next to resources/. Prefer Fleurdelys.bin when present
# because Fleurdelys is a GUI wrapper that adds Chromium flags not accepted by
# ELECTRON_RUN_AS_NODE.
if [ -x "${RESOURCES_DIR}/../MacOS/Fleurdelys" ]; then
  APP_EXECUTABLE="${RESOURCES_DIR}/../MacOS/Fleurdelys"
elif [ -x "${RESOURCES_DIR}/../Fleurdelys.bin" ]; then
  APP_EXECUTABLE="${RESOURCES_DIR}/../Fleurdelys.bin"
elif [ -x "${RESOURCES_DIR}/../Fleurdelys" ]; then
  APP_EXECUTABLE="${RESOURCES_DIR}/../Fleurdelys"
elif [ -x "${RESOURCES_DIR}/../MacOS/Paseo" ]; then
  APP_EXECUTABLE="${RESOURCES_DIR}/../MacOS/Paseo"
elif [ -x "${RESOURCES_DIR}/../Paseo.bin" ]; then
  APP_EXECUTABLE="${RESOURCES_DIR}/../Paseo.bin"
elif [ -x "${RESOURCES_DIR}/../Paseo" ]; then
  APP_EXECUTABLE="${RESOURCES_DIR}/../Paseo"
else
  echo "Bundled Fleurdelys executable not found relative to ${RESOURCES_DIR}" >&2
  exit 1
fi

RUNNER_PATH="${RESOURCES_DIR}/app.asar.unpacked/dist/daemon/node-entrypoint-runner.js"
CLI_ENTRYPOINT="${RESOURCES_DIR}/app.asar/node_modules/@fleurdelys/cli/dist/index.js"

if [ ! -f "$RUNNER_PATH" ]; then
  echo "Bundled Fleurdelys node runner not found at ${RUNNER_PATH}" >&2
  exit 1
fi

if [ ! -f "$CLI_ENTRYPOINT" ]; then
  echo "Bundled Fleurdelys CLI not found at ${CLI_ENTRYPOINT}" >&2
  exit 1
fi

ELECTRON_RUN_AS_NODE=1 PASEO_NODE_ENV=production "$APP_EXECUTABLE" \
  --disable-warning=DEP0040 \
  "$RUNNER_PATH" \
  node-script \
  "$CLI_ENTRYPOINT" \
  "$@"

