{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "*.lock",
    "**/*.gen.ts",
    "**/*.gen.tsx",
    ".omo/**",
    ".omc/**",
    "prototypes/**",
    "**/terminal-emulator-webview-html.ts",
    "docs/knowledge-graphs/**",
    "docs/modules/**/knowledge-graph.json"
  ]
}
